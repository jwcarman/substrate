<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.substrate</groupId>
        <artifactId>substrate-parent</artifactId>
        <version>0.13.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>substrate-bom</artifactId>
    <packaging>pom</packaging>

    <name>Substrate BOM</name>
    <description>Bill of Materials for Substrate — version alignment for consumers</description>

    <properties>
        <!-- Nothing to analyze: this module has no sources. -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-hazelcast</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-nats</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-dynamodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-rabbitmq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-cassandra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-sns</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.substrate</groupId>
                <artifactId>substrate-etcd</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Flattened on the way out, and only this module is.

        Importing a BOM pulls in its *effective* dependencyManagement, after inheritance, and
        substrate-parent inherits spring-boot-starter-parent for its own build. Published as-is,
        this BOM would re-export all of Spring Boot's managed versions, so a consumer importing it
        to align substrate's artifacts would have its Spring Boot, Jackson and JUnit versions
        decided for it too.

        bom mode writes the pom that is installed and deployed without the parent and with only
        the dependencyManagement declared here. The build still inherits normally, so
        versions:set, the release profile, the sonar: and spotless: prefixes and the license
        check all reach this module like any other.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.plugin.version}</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <!-- Inherited from the parent, and nothing a consumer of a BOM should see:
                             Spring Boot's version properties and the dependencies every module
                             declares. -->
                        <properties>remove</properties>
                        <dependencies>remove</dependencies>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
